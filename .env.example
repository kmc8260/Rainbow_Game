# 레인보우 홀덤 환경 변수 템플릿
# 실제 값은 Supabase 대시보드 > Project Settings > API 에서 확인하세요.
# 실제 키가 들어간 .env 파일은 저장소에 올리지 마세요.

# ---------- 프론트엔드 (js/supabase-config.js에 입력) ----------
# 브라우저에 공개되어도 되는 값입니다. (RLS로 보호)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- Edge Functions (deal-cards, place-bet) ----------
# Supabase에 배포하면 자동으로 주입됩니다. 로컬 테스트할 때만 입력하세요.
# SERVICE_ROLE_KEY는 절대 브라우저 코드에 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
